        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: perfume bottle\nDestination plate: autumn leaf litter (high-key key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
