      },
      {
        "id": "nd_F3788T6XY03Z3S631HSNBCEX77",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_FBQT22GWQT7WDF0X70T7K3S6DX",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_49NJ1RG03JDZS39MQECQ7P41Y1",
        "kind": "bg-remove",
        "position": {
