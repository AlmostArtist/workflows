        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: cosmetic jar\nDestination plate: rain-beaded glass (golden key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
