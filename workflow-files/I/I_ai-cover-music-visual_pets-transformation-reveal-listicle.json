        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: AI cover music visual\nTopic: pets\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 8s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_RV1RD70B3H0N6S7RJJJJV0CN7Q",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 format-native hook planning. The first 1.5 seconds carry the whole retention load."
