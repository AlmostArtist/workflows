          }
        },
        "name": "Brief joiner"
      },
      {
        "id": "nd_RY2A032SCJBBYJP6GJDVNR4MQR",
        "kind": "text-input",
        "position": {
          "x": 0,
          "y": 980
        },
        "config": {
          "text": "TRANSFORMATION: [what changes]\nHOLD: [what must not change]"
        },
        "name": "Change contract"
      },
      {
        "id": "nd_5ZRWXFHJEJYSBY77KA7KGTRRBM",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for a satisfying process clip about fashion trends.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with a hair light and background separation light with the key pulled two stops down and grade to a low-key grade holding detail in the deepest shadows only.\n\nReturn one prompt paragraph only.",
          "appendable_slots": {
            "reference_images": 1
          }
        },
        "name": "After-state writer"
      },
