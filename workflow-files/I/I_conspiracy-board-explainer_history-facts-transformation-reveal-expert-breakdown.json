      },
      {
        "id": "nd_H25PAY5ENJWRAAQ0YJSY49MAVJ",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_QFXH5CHD7XYND9G6P4H3AGF7EW",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
