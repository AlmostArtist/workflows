        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: boot pair\nDestination plate: greenhouse glass panes (high-key key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_Y3BTK8GBTHHR2V01XQJ2R91ED3",
