        "name": "Stage 1"
      },
      {
        "id": "nd_9MCDHEGW7EYK4KVX6DNA9T4A98",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_3FZEDN9QMJWYWZ37ZWFWZZ1PJR",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
