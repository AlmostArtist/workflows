        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: sunglasses\nDestination plate: gym rubber flooring (high-key key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_ZRWAGX95G6A3CDFX5RR4HJJVBE",
