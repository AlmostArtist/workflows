          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_TRTDCNHQN725ASVGV4E9FZ5WQB",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
          "appendable_slots": {
            "parts": 2
          }
        },
        "name": "Brief joiner"
      },
      {
        "id": "nd_QMSWRM998Y10EDYDBTE162ZJYF",
