        "name": "Stage 1"
      },
      {
        "id": "nd_WBC8S5R4TWBMPCS09BGDE8N3Y4",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_CY6DFF7YGPY68V72GJ5VCK2B01",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
