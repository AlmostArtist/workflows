        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: day-in-the-life speedrun\nTopic: space science\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 10s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_GZY3H3J5RDA4KA2MJ055V1TDV4",
