        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: motion-graphics text reveal\nTopic: tech news\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 12s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_M1CHXJSZHTRCWQD2WR34XJ3SWW",
