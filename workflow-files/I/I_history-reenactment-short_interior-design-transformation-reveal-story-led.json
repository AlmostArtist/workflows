      },
      {
        "id": "nd_XA4NR24ZJZWEKDK9B8TBW8Z4VP",
        "kind": "text-input",
        "position": {
          "x": 0,
          "y": 980
        },
        "config": {
          "text": "TRANSFORMATION: [what changes]\nHOLD: [what must not change]"
        },
        "name": "Change contract"
      },
      {
        "id": "nd_JV1SADC7EZPH02MC1FA983APV8",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for a history reenactment short about interior design.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with a large overhead octabox with a black flag killing the floor bounce and grade to a neutral commercial grade with clean whites and no colour cast.\n\nReturn one prompt paragraph only.",
