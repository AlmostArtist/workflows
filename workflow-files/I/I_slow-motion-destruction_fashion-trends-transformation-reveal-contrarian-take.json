        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: slow-motion destruction\nTopic: fashion trends\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 12s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_TEFYVW9M9X3YKM4EZTHFHW0TM9",
