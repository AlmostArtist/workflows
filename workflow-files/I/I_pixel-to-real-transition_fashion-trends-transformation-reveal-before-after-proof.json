        "name": "Stage 1"
      },
      {
        "id": "nd_A0CQ3DJ3D1XDXAHHSV6NT442E4",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_ZW3KY8S13XEMS08T7FAR1EAB32",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
