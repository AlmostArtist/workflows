        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: ceramic vase\nDestination plate: underwater caustics (studio key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
