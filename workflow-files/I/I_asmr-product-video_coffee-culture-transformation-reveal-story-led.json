      },
      {
        "id": "nd_ND91N7WHPERPRJHSR6NR358FSY",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for an ASMR product video about coffee culture.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with split gel lighting, teal on the shadow side and magenta on the key side and grade to a cinematic grade with a warm key and green-leaning ambient shadows.\n\nReturn one prompt paragraph only.",
          "appendable_slots": {
            "reference_images": 1
          }
        },
        "name": "After-state writer"
