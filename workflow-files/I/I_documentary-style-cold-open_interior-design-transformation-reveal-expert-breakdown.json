          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_FX77G4HMP4TJT06HY9S7G5N9TZ",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
          "appendable_slots": {
