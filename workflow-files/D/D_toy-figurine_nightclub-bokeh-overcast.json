        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: toy figurine\nDestination plate: nightclub bokeh (overcast key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_BZSWMQEBHT0P62CQJGDYF2J6CP",
