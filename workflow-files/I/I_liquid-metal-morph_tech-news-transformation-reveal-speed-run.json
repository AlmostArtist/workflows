        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: liquid metal morph\nTopic: tech news\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 10s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_QZTFT2X2MRCR4ZJJRKYWQX9C32",
