        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: perfume bottle\nDestination plate: gallery white cube (golden key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_E6K8KMHDRXYNF2N93E9EQC4Y7X",
