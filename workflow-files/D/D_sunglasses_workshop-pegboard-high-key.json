          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_6TB6KYGK73YNX41R6YYMHV22K8",
        "kind": "bg-remove",
        "position": {
