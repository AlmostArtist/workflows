    "name": "I \u2014 AI news anchor brief on history facts (transformation reveal)",
    "nodes": [
      {
        "id": "nd_HGAHCZYNMK3TKPJ24VB9KQ81BM",
        "kind": "prompt",
        "position": {
          "x": 0,
