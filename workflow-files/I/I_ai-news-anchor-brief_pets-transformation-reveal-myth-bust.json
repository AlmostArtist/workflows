      },
      {
        "id": "nd_VR79CPYV22SBS8QMGN10TRAXAB",
        "kind": "text-input",
        "position": {
          "x": 0,
          "y": 980
        },
        "config": {
          "text": "TRANSFORMATION: [what changes]\nHOLD: [what must not change]"
        },
        "name": "Change contract"
      },
      {
        "id": "nd_9RF2TVCKVJ97THWQD70Z45WRF5",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for an AI news anchor brief about pets.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with split gel lighting, teal on the shadow side and magenta on the key side and grade to a pastel low-contrast grade with a lifted black point.\n\nReturn one prompt paragraph only.",
