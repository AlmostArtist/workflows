        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: history reenactment short\nTopic: pets\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 12s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_ZXZEKGZGZKY0YREJ3BNHD80BF0",
