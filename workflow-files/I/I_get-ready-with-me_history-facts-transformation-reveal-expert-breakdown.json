        "name": "Stage 1"
      },
      {
        "id": "nd_478EXCDN7Z9A4MF78BYSMXEE3E",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_D2XQ0EQY6ASV904ZD9C98844JF",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
