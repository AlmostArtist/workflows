        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: transformation reveal\nTopic: sustainability\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 6s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_DYY6CYTC3BYYCPJ0J25SQJSPKB",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
