        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: electric vehicle\nAd format: unboxing ad\nTarget viewer: a night-shift nurse\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 30 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_SV8KSP8BH6HPRQXH63X4SM0XB0",
