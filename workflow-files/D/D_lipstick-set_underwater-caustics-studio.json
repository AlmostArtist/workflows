        },
        "config": {},
        "name": "Cut out subject"
      },
      {
        "id": "nd_Z5EJSD1PRY3MSGPJ5GMFKTNT78",
        "kind": "download",
        "position": {
          "x": 2800,
          "y": 420
        },
        "config": {
