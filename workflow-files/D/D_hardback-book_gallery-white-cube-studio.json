        },
        "name": "Output ratio"
      },
      {
        "id": "nd_68F727X2HQF4596343N5Z1GNBG",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_MDK0AW835WQGN13CXEZXX0A586",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_MGS4BGXD05SDZBFX90AX1393JF",
        "kind": "bg-remove",
        "position": {
