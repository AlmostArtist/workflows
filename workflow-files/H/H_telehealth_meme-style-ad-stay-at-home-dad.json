    "name": "H \u2014 meme-style ad for telehealth, 15s",
    "nodes": [
      {
        "id": "nd_CWM8AMES6Q05GWM8GHKQENYB6J",
        "kind": "prompt",
        "position": {
          "x": 0,
          "y": 400
        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: telehealth\nAd format: meme-style ad\nTarget viewer: a stay-at-home dad\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 15 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_ZBQJQTFVSAGYP7PRE73JPMQM10",
        "kind": "character-input",
        "position": {
          "x": 0,
