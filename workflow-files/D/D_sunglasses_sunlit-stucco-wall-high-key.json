      },
      {
        "id": "nd_FXPEAEKQQ3YC21RVXTMR06BJM2",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_Q0GBQR8TT0FV1MHRV947KYDK4D",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_A1W6YRRF6FNTHC8HYWBK5NA59Q",
        "kind": "bg-remove",
        "position": {
          "x": 700,
          "y": 300
