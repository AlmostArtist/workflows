        "name": "Stage 1"
      },
      {
        "id": "nd_24XH7GX76XEPE97PJ0YH36996S",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_Z3D9M3R2BT3SPVFR5PXWW8TFAT",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
