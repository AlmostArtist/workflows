        "config": {
          "model": "gpt-5.5",
          "max_tokens": 1500,
          "temperature": 0.75,
          "system_prompt": "You are the art director synthesising a single design lock for the character concept 'retired stunt driver, 1920s, rendered as airbrush'.\n\nUsing the brief and the attached moodboard image as tone reference only, fix: age, build, posture, face, hair, full costume layer by layer, at least four named materials with their wear state, palette with three named colours, and one signature prop.\n\nNever copy a specific person or a copyrighted character from the moodboard \u2014 take palette, mood and material language only.\n\nGrade target: warm amber highlights rolling into cool slate shadows. Lighting reference: tungsten practicals in frame carrying the warm layer.\n\nReturn the design lock as one dense paragraph, no headings, no commentary.",
          "appendable_slots": {
            "reference_images": 1
          }
        },
        "name": "Design lock"
      },
      {
        "id": "nd_GXP2QA7AFXS74HFVYFDFW8X5V4",
