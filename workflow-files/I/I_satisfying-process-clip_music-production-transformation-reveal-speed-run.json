        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_W1NMGWMBWD7HH0EH5K3N0TN8K5",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
