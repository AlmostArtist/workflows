        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: kitchen mixer\nDestination plate: nightclub bokeh (night key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_J925BP7M5Y96Z6G7BNA81PM3FJ",
