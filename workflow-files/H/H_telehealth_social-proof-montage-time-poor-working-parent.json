    "name": "H \u2014 social proof montage for telehealth, 15s",
    "nodes": [
      {
        "id": "nd_6HW6Q8JZG1R9R66JXZHN6BN7WX",
        "kind": "prompt",
        "position": {
          "x": 0,
          "y": 400
        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: telehealth\nAd format: social proof montage\nTarget viewer: a time-poor working parent\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 15 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_79TP17GMPCBY17988AVT102SV1",
        "kind": "character-input",
        "position": {
          "x": 0,
