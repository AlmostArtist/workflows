        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: ASMR product video\nTopic: ocean life\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 12s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_X42AWAH2T0R7KK5XFH7S78AKKR",
