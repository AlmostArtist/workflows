        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_R7G405N1NP9CJH2DW76WKA6GXH",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
