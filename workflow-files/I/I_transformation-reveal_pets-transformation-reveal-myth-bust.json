        "name": "Stage 1"
      },
      {
        "id": "nd_XTRJKY6RZ717PCW676EJ0NZGVJ",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_GBF3R5J2SNRN7625W76RTJ7507",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
