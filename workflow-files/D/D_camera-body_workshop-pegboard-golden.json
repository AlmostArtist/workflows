        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: camera body\nDestination plate: workshop pegboard (golden key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_G705THN0SH0B9JZP8T5RDWNEGQ",
