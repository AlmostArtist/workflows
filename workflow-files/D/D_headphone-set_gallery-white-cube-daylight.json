        },
        "name": "Output ratio"
      },
      {
        "id": "nd_2WDT5C7MR73N8B38WZ90NYJ4K9",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_952ZN44G1GA2HVANVMAN4S9H8H",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_WQ4F16SST1M140RMSBC27TDN74",
        "kind": "bg-remove",
        "position": {
