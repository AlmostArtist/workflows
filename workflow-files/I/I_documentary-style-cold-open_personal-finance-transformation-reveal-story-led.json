    "name": "I \u2014 documentary-style cold open on personal finance (transformation reveal)",
    "nodes": [
      {
        "id": "nd_1WYG3XR5BNFXS8BMBE5VBDWV4F",
        "kind": "prompt",
        "position": {
          "x": 0,
          "y": 400
