          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_WXE8F1ZMVBSW3F55TH2EQD6XJ0",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
          "appendable_slots": {
            "parts": 2
          }
        },
        "name": "Brief joiner"
      },
      {
        "id": "nd_TDZV4Q8JHP6102AAG7DRE1XZQ7",
