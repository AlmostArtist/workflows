      },
      {
        "id": "nd_EWGYE8SVJJMA2VNRE0FBE90HWK",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for a history reenactment short about real estate.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with north-facing window light with a black v-flat for negative fill and grade to a clean high-key grade with the whites pushed to the edge of clipping.\n\nReturn one prompt paragraph only.",
          "appendable_slots": {
            "reference_images": 1
          }
        },
        "name": "After-state writer"
      },
