      },
      {
        "id": "nd_0ERJSTSB9MWN5KT13E5MK7M91F",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for an ASMR product video about AI tools.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with a large overhead octabox with a black flag killing the floor bounce and grade to a punchy saturated candy palette with hard primaries.\n\nReturn one prompt paragraph only.",
