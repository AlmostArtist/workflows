      },
      {
        "id": "nd_4X6493S2M1V6WYKT792QE1MHYC",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_Q0JDFTMY8RXV8861M1DX4371Q2",
        "kind": "sticky-note",
        "position": {
