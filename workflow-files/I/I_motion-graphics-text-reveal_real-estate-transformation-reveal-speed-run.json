        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 format-native hook planning. The first 1.5 seconds carry the whole retention load."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_S3G88NCERH0EAGE2KT0VEGEW75",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_Q3HF37NV2WJ9TSZ24A2WM9VVXP",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
