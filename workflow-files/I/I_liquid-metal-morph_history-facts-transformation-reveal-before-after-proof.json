        "name": "Stage 1"
      },
      {
        "id": "nd_99QB6WTDMN6YFZ18K6ZGSZJX1M",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_PCSEH3A4K44YE6KCZ9A7C3AQNF",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
