        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: desk lamp\nDestination plate: gallery white cube (daylight key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_GRJ205EP3HSMVQ6CAN2NVZ8BZ7",
