        },
        "name": "Output ratio"
      },
      {
        "id": "nd_Q6A3TQ2ZEKQRTNTE1V0ADV5RC4",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_N1RE1N098C5JTWP5TBKV7WK9DK",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_P4CYHHYPRHBHBWQ7N8S59RR55F",
        "kind": "bg-remove",
        "position": {
