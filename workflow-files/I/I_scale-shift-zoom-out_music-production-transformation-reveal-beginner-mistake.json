        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: scale-shift zoom out\nTopic: music production\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 8s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_R8P10PZC0DZQP73A43W7N9F1E1",
