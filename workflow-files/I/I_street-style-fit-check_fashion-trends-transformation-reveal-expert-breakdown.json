      },
      {
        "id": "nd_J4JJZQVJ9TKBAZGSE6K94VREE1",
        "kind": "text-input",
        "position": {
          "x": 0,
          "y": 980
        },
        "config": {
          "text": "TRANSFORMATION: [what changes]\nHOLD: [what must not change]"
        },
