    "name": "H \u2014 meme-style ad for telehealth, 30s",
    "nodes": [
      {
        "id": "nd_JCCXQY64EHPWXJHA45JG77H537",
        "kind": "prompt",
        "position": {
          "x": 0,
          "y": 400
        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: telehealth\nAd format: meme-style ad\nTarget viewer: a time-poor working parent\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 30 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_WA2J6XXZK39NWC66J2AEAZQNZN",
