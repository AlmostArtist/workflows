            "images": 2
          }
        },
        "name": "Composites"
      },
      {
        "id": "nd_W1S8YAN9G2W9R9BSP0E5X1H2HM",
        "kind": "text-gen",
        "position": {
          "x": 1400,
          "y": 180
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 1300,
          "temperature": 0.48,
          "system_prompt": "You are the compositing and relighting director placing an ecommerce sneaker cutout into a new environment.\n\nINPUTS. Reference slot one is the cut-out subject with its background already removed; the remaining slots are the destination plate: underwater caustics (daylight key).\n\nMATCH. Your prompt must force the subject's light to match the plate: state the key direction in degrees, the colour temperature difference, the shadow softness and length, and where the contact shadow grounds the object. A composite fails on contact shadow and edge light before anything else.\n\nCAMERA MATCH. Reconcile perspective and lens: 50mm normal at f/1.4, matching horizon height and the plate's depth of field falloff.\n\nINTEGRATION. Call for matching grain, matching chromatic aberration at the edges, spill light from the plate onto the subject, and a desaturated Nordic palette with cold blue shadows.\n\nPRESERVE. Do not alter the subject's shape, colourway or printed label in any way.\n\nOUTPUT. Emit one prompt, one paragraph, no framing text of any kind before or after it.\n\nVARIANT. This branch renders a daylight-matched treatment with a hard contact shadow.",
          "appendable_slots": {
            "reference_images": 2
          }
        },
        "name": "Relight director 1"
      },
      {
        "id": "nd_RT2V48SSNKMTH5TQWMJ86CAG6J",
        "kind": "image-gen",
        "position": {
          "x": 2100,
          "y": 180
        },
        "config": {
          "model": "gemini-3-pro-image-preview",
          "quality": "auto",
          "image_size": "1K",
          "num_images": 1,
          "enable_eval": true,
          "eval_model": "gemini-2.5-pro",
          "eval_prompt": "Reject any render where the contact shadow is missing, the edge light contradicts the plate's key direction, or the product geometry or label differs from the cut-out.",
          "eval_min_score": 7,
          "eval_max_retries": 2,
          "output_format": "png",
          "appendable_slots": {
            "reference_images": 2
          }
        },
        "name": "Composite 1"
