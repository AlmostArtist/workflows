        "name": "Stage 1"
      },
      {
        "id": "nd_DZX8QZ5F65QGGHAR8HP11XQ71G",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_JJW42EB8DTDA5QF0B2Y7TMJ6PT",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
