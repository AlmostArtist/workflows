        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: conspiracy-board explainer\nTopic: space science\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 8s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
