        "name": "Stage 1"
      },
      {
        "id": "nd_D9W00BPFNPJBW5ZQNAGGYCW5M5",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_TPX6KQ5BVTBBYS24JWRR6REVN3",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
