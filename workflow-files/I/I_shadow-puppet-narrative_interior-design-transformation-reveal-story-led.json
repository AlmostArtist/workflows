        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_4TCS54A8HJHP9VFVYGHEMA2MA6",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
