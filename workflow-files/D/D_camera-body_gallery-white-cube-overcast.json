        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: camera body\nDestination plate: gallery white cube (overcast key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_NG5KW83PQNS24EAVQ4G632NJZM",
