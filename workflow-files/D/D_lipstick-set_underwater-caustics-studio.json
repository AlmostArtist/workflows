        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: lipstick set\nDestination plate: underwater caustics (studio key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_64E29HGGF2HRMV549G3ZWR19Y9",
