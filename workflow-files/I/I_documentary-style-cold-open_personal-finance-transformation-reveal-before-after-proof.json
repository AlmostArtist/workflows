        "name": "Stage 1"
      },
      {
        "id": "nd_WD7605Z3423SQN3611D8TZ1ATZ",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
