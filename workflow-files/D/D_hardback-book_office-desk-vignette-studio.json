          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_EJ93KK8S269X461FJ1TCN5GAXJ",
        "kind": "bg-remove",
        "position": {
