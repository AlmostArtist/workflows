        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: gift hamper\nDestination plate: gallery white cube (golden key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_DN24TPB5ZQ7XYYGFCYPPMR75KS",
