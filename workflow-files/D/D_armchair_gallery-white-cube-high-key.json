        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: armchair\nDestination plate: gallery white cube (high-key key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_KFEK6TGYJ6G44S57ENC2WGMBT0",
        "kind": "aspect-ratio-input",
        "position": {
          "x": 0,
          "y": 1060
        },
