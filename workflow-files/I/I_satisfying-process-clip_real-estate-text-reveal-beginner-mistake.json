        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: satisfying process clip\nTopic: real estate\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 6s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_ABA1CW76ZX5Z0P0BBE3D2TSTT8",
