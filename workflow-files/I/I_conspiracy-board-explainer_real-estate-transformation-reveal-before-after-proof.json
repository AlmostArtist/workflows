        "name": "Stage 1"
      },
      {
        "id": "nd_WC7AAEX8D097ZK4MSH1DQ7G5H6",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
