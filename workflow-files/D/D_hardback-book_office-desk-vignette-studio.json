      },
      {
        "id": "nd_JJK7SKJYRP2F9M2263CZS0S1ZC",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_3VEHMFNENRYCGZG2W358V8WC2Z",
        "kind": "sticky-note",
        "position": {
