        },
        "name": "Output ratio"
      },
      {
        "id": "nd_NK6C6ZA2T4Z56WD18PKNYTQ0KB",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_DS93M7R88K6VH7JQTMBAJK5G6H",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_N5WEX6PJYKW3J4W9DCKMHB9B61",
        "kind": "bg-remove",
