      },
      {
        "id": "nd_0P7RR5Z91045TPSK73F23SQM06",
        "kind": "text-input",
        "position": {
          "x": 0,
          "y": 980
        },
        "config": {
          "text": "TRANSFORMATION: [what changes]\nHOLD: [what must not change]"
        },
        "name": "Change contract"
      },
      {
        "id": "nd_Q4SMVQW5PQJ3SH1X82R1DQA5RG",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for a street-style fit check about fashion trends.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with blue-hour ambient with a single warm practical for separation and grade to a neutral commercial grade with clean whites and no colour cast.\n\nReturn one prompt paragraph only.",
