        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: ASMR product video\nTopic: home organisation\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 6s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_K0ZJ3CY0ZNB6X9Z86ZFR6TEGRT",
