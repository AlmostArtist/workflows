        "name": "Stage 1"
      },
      {
        "id": "nd_YXJQGBG7MJ51PDXK2720466H0W",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_7AT6NFS25D0E4XAGAZ81T1R67M",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
