        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: travel booking app\nAd format: comparison ad\nTarget viewer: a mid-career manager chasing a promotion\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 30 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
