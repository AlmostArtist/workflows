      },
      {
        "id": "nd_MJMQYN9G5HCJCZPCP14RMN9GXV",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for a street-style fit check about fitness myths.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with a large overhead octabox with a black flag killing the floor bounce and grade to a clean high-key grade with the whites pushed to the edge of clipping.\n\nReturn one prompt paragraph only.",
