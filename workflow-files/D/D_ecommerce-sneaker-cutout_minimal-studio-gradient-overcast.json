        },
        "name": "Output ratio"
      },
      {
        "id": "nd_ZSMPRK71SPYRPKYPZ0MRY0K4HQ",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_WAAPFFBM6ZX7KCR0C46X5FMT8Y",
