        "name": "Stage 1"
      },
      {
        "id": "nd_D9H5F492N3VTFP2PH9FSTG00PQ",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_1TM58EHX7CGRHNNE9M5AY83QVC",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
