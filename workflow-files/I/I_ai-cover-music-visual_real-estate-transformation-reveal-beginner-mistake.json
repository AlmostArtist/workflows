        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: AI cover music visual\nTopic: real estate\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 12s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_KX5ATG1JS9J0ARGNZ9A0PK3H4S",
