        "config": {
          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_QJW4DPPKCX89VXTPVQJR1W08AD",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
          "appendable_slots": {
