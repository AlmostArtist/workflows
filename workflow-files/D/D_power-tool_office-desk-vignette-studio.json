        },
        "name": "Output ratio"
      },
      {
        "id": "nd_28V87MP7J92BMKQF7KY3ZPEAE3",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_77NBC1RA1Q1DEVF8707ECVMD5Z",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_FR1RR7V8PK4AKTBTH4SZFRHVNM",
        "kind": "bg-remove",
        "position": {
          "x": 700,
