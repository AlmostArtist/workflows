        "config": {
          "model": "gpt-5.5",
          "max_tokens": 1500,
          "temperature": 0.75,
          "system_prompt": "You are the art director synthesising a single design lock for the character concept 'salt harvester, 1970s, rendered as voxel'.\n\nUsing the brief and the attached moodboard image as tone reference only, fix: age, build, posture, face, hair, full costume layer by layer, at least four named materials with their wear state, palette with three named colours, and one signature prop.\n\nNever copy a specific person or a copyrighted character from the moodboard \u2014 take palette, mood and material language only.\n\nGrade target: a neutral commercial grade with clean whites and no colour cast. Lighting reference: an overcast soft dome with no directional shadow at all.\n\nReturn the design lock as one dense paragraph, no headings, no commentary.",
          "appendable_slots": {
            "reference_images": 1
          }
        },
        "name": "Design lock"
      },
      {
        "id": "nd_G7VKKEZX8C5DDM2FDD2677G5JG",
        "kind": "download",
        "position": {
