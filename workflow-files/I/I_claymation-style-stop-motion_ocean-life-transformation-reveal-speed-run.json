        "name": "Stage 1"
      },
      {
        "id": "nd_2BQKZKBVEE5F3PEYYPCPBTM5AG",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_RZ4JF3FPEMG2R5KAN9ZNRA4TKE",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
