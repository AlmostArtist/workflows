        "name": "Stage 1"
      },
      {
        "id": "nd_DA3YS7SXA0ZEP3K46Z1PVJNC3X",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_6JQ81G7VWC4YY8AYFZD19M6YSK",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
