        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: slow-motion destruction\nTopic: fitness myths\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 10s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_6BDC24Y4RR1RXM8R5BQG5RTC4N",
