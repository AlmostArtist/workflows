      },
      {
        "id": "nd_RJ5WDBP76DVQS3HNNJP3DA52GV",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for a silent review about productivity hacks.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with a book light bounce producing an extremely soft wrap and grade to warm amber highlights rolling into cool slate shadows.\n\nReturn one prompt paragraph only.",
