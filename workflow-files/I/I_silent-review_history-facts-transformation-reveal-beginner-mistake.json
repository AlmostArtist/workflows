          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_F0JQ85N8G3E7CX0QSPAZZ7ZB73",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
