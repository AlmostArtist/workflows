        "position": {
          "x": 0,
          "y": 980
        },
        "config": {
          "text": "TRANSFORMATION: [what changes]\nHOLD: [what must not change]"
        },
        "name": "Change contract"
      },
      {
        "id": "nd_WNYMP6PNBNE9M5H31SY45SS6QA",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for a text-message story reenactment about history facts.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with blue-hour ambient with a single warm practical for separation and grade to a sun-bleached grade with faded blacks and a green-yellow bias.\n\nReturn one prompt paragraph only.",
          "appendable_slots": {
            "reference_images": 1
          }
        },
        "name": "After-state writer"
