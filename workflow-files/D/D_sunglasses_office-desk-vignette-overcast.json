      },
      {
        "id": "nd_4X4SQFJRCQHGX47343T3JNCQ4W",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_M0Q7STDAVEEKCTXJK71555KSYV",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_FA9DQNDR1T2TJ2MJZZHVJVZ343",
        "kind": "bg-remove",
        "position": {
