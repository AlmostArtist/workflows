        },
        "config": {},
        "name": "Cut out subject"
      },
      {
        "id": "nd_YB6BSFEPEBNHVN4A95ZEX3TBCV",
        "kind": "download",
        "position": {
          "x": 2800,
          "y": 420
        },
        "config": {
