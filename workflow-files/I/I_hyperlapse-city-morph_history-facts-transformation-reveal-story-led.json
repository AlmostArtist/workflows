        "config": {
          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_K9ZW7VZ5RM9R7ZSV8SX9BPB97G",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
