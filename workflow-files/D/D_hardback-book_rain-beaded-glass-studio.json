        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: hardback book\nDestination plate: rain-beaded glass (studio key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_PER9855TW21AVEAPQ9YAZ3TC42",
