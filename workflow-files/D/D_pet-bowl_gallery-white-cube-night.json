        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: pet bowl\nDestination plate: gallery white cube (night key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_AB1AFJQWF6YYX3YC5XSWR8ZGDE",
