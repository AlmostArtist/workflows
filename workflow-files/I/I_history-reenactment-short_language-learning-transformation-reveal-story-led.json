        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: history reenactment short\nTopic: language learning\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 12s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_95WF0Y2TT73YA7SD759ARMETD5",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 format-native hook planning. The first 1.5 seconds carry the whole retention load."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_W7ES1X1MJM68PCD9J9MYX9KY97",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_SZ5R5BM0JAPR423KBH3M8XADB7",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
