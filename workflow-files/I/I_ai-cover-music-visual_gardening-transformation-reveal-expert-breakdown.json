        "name": "Stage 1"
      },
      {
        "id": "nd_CZ9MG254021N1EHYQQH4BBKXHX",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_8DW2YFAG6A1699NYKW2WK1SY8B",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
