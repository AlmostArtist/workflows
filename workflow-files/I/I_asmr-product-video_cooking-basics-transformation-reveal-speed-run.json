      },
      {
        "id": "nd_KHE1580WSGHZJ746M41JYDRK5Y",
        "kind": "text-input",
        "position": {
          "x": 0,
          "y": 980
        },
        "config": {
          "text": "TRANSFORMATION: [what changes]\nHOLD: [what must not change]"
        },
        "name": "Change contract"
      },
      {
        "id": "nd_MPSE96SREHP6CCNT2BNVEVGF9N",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for an ASMR product video about cooking basics.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with a ring light on axis for flat, modern, shadowless coverage and grade to high-contrast teal-and-orange with protected mid-tone skin.\n\nReturn one prompt paragraph only.",
