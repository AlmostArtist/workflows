          "y": 300
        },
        "config": {},
        "name": "Cut out subject"
      },
      {
        "id": "nd_SBDZTN0B0YC0MEMGE90XA1XJ20",
        "kind": "download",
        "position": {
          "x": 2800,
          "y": 420
        },
        "config": {
          "appendable_slots": {
            "images": 2
          }
        },
        "name": "Composites"
      },
      {
        "id": "nd_E35WRFDK0VDV2CZTVEJ6TJ965P",
        "kind": "text-gen",
        "position": {
          "x": 1400,
          "y": 180
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 1300,
          "temperature": 0.6,
          "system_prompt": "You are the compositing and relighting director placing a sunglasses into a new environment.\n\nINPUTS. Reference slot one is the cut-out subject with its background already removed; the remaining slots are the destination plate: office desk vignette (overcast key).\n\nMATCH. Your prompt must force the subject's light to match the plate: state the key direction in degrees, the colour temperature difference, the shadow softness and length, and where the contact shadow grounds the object. A composite fails on contact shadow and edge light before anything else.\n\nCAMERA MATCH. Reconcile perspective and lens: 14mm ultra-wide at f/8, matching horizon height and the plate's depth of field falloff.\n\nINTEGRATION. Call for matching grain, matching chromatic aberration at the edges, spill light from the plate onto the subject, and a neutral commercial grade with clean whites and no colour cast.\n\nPRESERVE. Do not alter the subject's shape, colourway or printed label in any way.\n\nOUTPUT. Emit one prompt, one paragraph, no framing text of any kind before or after it.\n\nVARIANT. This branch renders an overcast treatment with a soft wrap and a wide ambient occlusion.",
          "appendable_slots": {
            "reference_images": 2
          }
        },
        "name": "Relight director 1"
      },
      {
        "id": "nd_QMZN2KNTMPWV6D3EPK6Z4817T9",
        "kind": "image-gen",
        "position": {
          "x": 2100,
          "y": 180
        },
        "config": {
          "model": "gemini-3-pro-image-preview",
          "quality": "auto",
          "image_size": "1K",
          "num_images": 1,
          "enable_eval": true,
          "eval_model": "gemini-2.5-pro",
          "eval_prompt": "Reject any render where the contact shadow is missing, the edge light contradicts the plate's key direction, or the product geometry or label differs from the cut-out.",
          "eval_min_score": 7,
          "eval_max_retries": 2,
          "output_format": "png",
          "appendable_slots": {
            "reference_images": 2
          }
        },
        "name": "Composite 1"
