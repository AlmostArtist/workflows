      },
      {
        "id": "nd_981Z0M2821JGEDY7K6C8WBZQA0",
        "kind": "text-input",
        "position": {
          "x": 0,
          "y": 980
        },
        "config": {
          "text": "TRANSFORMATION: [what changes]\nHOLD: [what must not change]"
        },
