        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: B2B logistics\nAd format: UGC selfie ad\nTarget viewer: a first-year university student\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 30 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
