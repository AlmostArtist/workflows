        },
        "name": "Output ratio"
      },
      {
        "id": "nd_SZQQ33MWZ4BRHZH917TJENTWAT",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_4QE52EVF7EPQBR8268N5CXGKPS",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_SA0Y5NC65DD8YA5W27K6W0G0G9",
        "kind": "bg-remove",
        "position": {
