    "name": "H \u2014 before-and-after ad for telehealth, 15s",
    "nodes": [
      {
        "id": "nd_P9TKNY6RX2WWMWV4K223NR9A85",
        "kind": "prompt",
        "position": {
          "x": 0,
          "y": 400
        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: telehealth\nAd format: before-and-after ad\nTarget viewer: a first-year university student\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 15 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_ZSE3BDFAPSWEPMV2E070B9MGEY",
        "kind": "character-input",
