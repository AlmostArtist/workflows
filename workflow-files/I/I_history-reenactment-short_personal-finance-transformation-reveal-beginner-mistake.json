        "name": "Stage 1"
      },
      {
        "id": "nd_6YH7NR2WECA1HAB0YK0T1KZM5V",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_91CXR59Y6D607W3N2PAJF447PN",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
