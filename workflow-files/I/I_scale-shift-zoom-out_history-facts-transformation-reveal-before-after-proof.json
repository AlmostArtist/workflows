        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_FBVR0996Y1N52RK3D6J0RFS98W",
        "kind": "text-gen",
        "position": {
          "x": 700,
