        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: candle jar\nDestination plate: workshop pegboard (daylight key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
