        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: POV first-person scene\nTopic: language learning\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 6s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_XCVSX9XAH6DFP8WMSW3V2MD1PD",
