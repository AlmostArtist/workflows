        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: meme remix format\nTopic: cooking basics\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 6s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
