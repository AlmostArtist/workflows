        "name": "Stage 1"
      },
      {
        "id": "nd_2PHQQHM3482485EART6VWJKQ31",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_1PV3339VM7QVCVE34P6WQAXN8G",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
