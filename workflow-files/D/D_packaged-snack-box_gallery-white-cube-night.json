            "images": 2
          }
        },
        "name": "Composites"
      },
      {
        "id": "nd_BEEJE5EA0CHJPNCW0W9XGX43N9",
        "kind": "text-gen",
        "position": {
          "x": 1400,
          "y": 180
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 1300,
          "temperature": 0.46,
          "system_prompt": "You are the compositing and relighting director placing a packaged snack box into a new environment.\n\nINPUTS. Reference slot one is the cut-out subject with its background already removed; the remaining slots are the destination plate: gallery white cube (night key).\n\nMATCH. Your prompt must force the subject's light to match the plate: state the key direction in degrees, the colour temperature difference, the shadow softness and length, and where the contact shadow grounds the object. A composite fails on contact shadow and edge light before anything else.\n\nCAMERA MATCH. Reconcile perspective and lens: 8mm circular fisheye at f/16, matching horizon height and the plate's depth of field falloff.\n\nINTEGRATION. Call for matching grain, matching chromatic aberration at the edges, spill light from the plate onto the subject, and high-contrast teal-and-orange with protected mid-tone skin.\n\nPRESERVE. Do not alter the subject's shape, colourway or printed label in any way.\n\nOUTPUT. The response must be a lone prompt paragraph \u2014 strip any header, numbering or sign-off.\n\nVARIANT. This branch renders a night treatment with two coloured practicals and a wet-surface reflection.",
          "appendable_slots": {
            "reference_images": 2
          }
        },
        "name": "Relight director 1"
      },
      {
        "id": "nd_2D40A7W8KF4ARX9S7VBVKND6P6",
        "kind": "image-gen",
        "position": {
          "x": 2100,
          "y": 180
        },
        "config": {
          "model": "gemini-3.1-flash-image-preview",
          "quality": "auto",
          "image_size": "1K",
          "num_images": 1,
          "enable_eval": true,
          "eval_model": "gemini-2.5-pro",
          "eval_prompt": "Reject any render where the contact shadow is missing, the edge light contradicts the plate's key direction, or the product geometry or label differs from the cut-out.",
          "eval_min_score": 7,
          "eval_max_retries": 2,
          "output_format": "png",
          "appendable_slots": {
