        "name": "Stage 1"
      },
      {
        "id": "nd_XKA0Y5XAB2R9ZVQDHKSPSZMGB8",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_SNTP7AM3743DNPG4BJQZ4GNNPC",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
