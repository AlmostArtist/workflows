        },
        "name": "Brief joiner"
      },
      {
        "id": "nd_SQFZ1KNGWZE55YC3CE6RC0FS78",
        "kind": "text-input",
        "position": {
          "x": 0,
          "y": 980
        },
        "config": {
          "text": "TRANSFORMATION: [what changes]\nHOLD: [what must not change]"
        },
        "name": "Change contract"
      },
      {
        "id": "nd_T1P6FRG3VHEPDZ0X9RZ8161C5R",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for an AI influencer talking head about photography basics.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with a single 90cm softbox key at 45 degrees with a white bounce card for fill and grade to a filmic grade with halation on the specular highlights.\n\nReturn one prompt paragraph only.",
          "appendable_slots": {
            "reference_images": 1
          }
        },
        "name": "After-state writer"
      },
