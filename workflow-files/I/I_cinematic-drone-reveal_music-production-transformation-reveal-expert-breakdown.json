      },
      {
        "id": "nd_4T2046W198MBCT9P767RK5DD7B",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for a cinematic drone reveal about music production.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with paired strip-box rim lights raking both edges of the subject and grade to near-monochrome with a single accent hue allowed to stay saturated.\n\nReturn one prompt paragraph only.",
