        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: ecommerce sneaker cutout\nDestination plate: sunlit stucco wall (night key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_9PER4MN1PT0QNFFH3A72FCKRG4",
