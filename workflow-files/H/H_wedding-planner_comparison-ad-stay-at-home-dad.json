        "position": {
          "x": 0,
          "y": 400
        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: wedding planner\nAd format: comparison ad\nTarget viewer: a stay-at-home dad\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 20 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_QM3XYDEBM8K4R2HZJG7NQ20JB0",
