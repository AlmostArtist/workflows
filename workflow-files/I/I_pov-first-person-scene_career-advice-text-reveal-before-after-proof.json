        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: POV first-person scene\nTopic: career advice\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 8s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_5NGCRQ1M7JV7SN8T3JH5BN8EMZ",
