        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: fintech app\nAd format: tutorial ad\nTarget viewer: a new graduate on a tight budget\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 15 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_86RGAM98NF50N3X93XK2VFXCCX",
