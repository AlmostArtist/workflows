          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_CHH3XWNJFWRJTXDXXZKDM475R8",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
          "appendable_slots": {
