        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 format-native hook planning. The first 1.5 seconds carry the whole retention load."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_B063WB1N62SBZDBKN4PB07K56A",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_ZV0TCVZ9VMCZQW3TTJ0ET8KRF8",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
