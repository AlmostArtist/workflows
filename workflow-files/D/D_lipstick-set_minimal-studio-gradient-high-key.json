        },
        "config": {},
        "name": "Cut out subject"
      },
      {
        "id": "nd_QBJTMHE504NN43GB2B7BFEMQ8V",
        "kind": "download",
        "position": {
          "x": 2800,
          "y": 420
        },
        "config": {
