        },
        "name": "Output ratio"
      },
      {
        "id": "nd_PC9V8EFAEM3K1KMJA4TYH8R67J",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_VAMD1PC1CE77DJF2NEWM8B08SR",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_AG9JQ8HNFFBC9Q96NYX8Y90XHQ",
        "kind": "bg-remove",
        "position": {
