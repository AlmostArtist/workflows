          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_JYV5ZD8ZPAMM0G6XYG7SCPHHN4",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
          "appendable_slots": {
            "parts": 2
          }
        },
        "name": "Brief joiner"
      },
      {
        "id": "nd_EM2NCMHVK13EH3JQH8AJ8STTXF",
        "kind": "text-input",
        "position": {
          "x": 0,
          "y": 980
        },
        "config": {
          "text": "TRANSFORMATION: [what changes]\nHOLD: [what must not change]"
        },
        "name": "Change contract"
      },
      {
        "id": "nd_5SEKDY98DVJ27956A177PSVW3T",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for a claymation-style stop motion about music production.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with LED tube accents in two contrasting hues placed in depth and grade to a low-key grade holding detail in the deepest shadows only.\n\nReturn one prompt paragraph only.",
