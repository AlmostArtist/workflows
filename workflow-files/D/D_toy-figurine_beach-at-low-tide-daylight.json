        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: toy figurine\nDestination plate: beach at low tide (daylight key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
