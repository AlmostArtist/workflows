        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: liquid metal morph\nTopic: AI tools\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 8s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_TQ7M7FAPNR2CDF3RFS5JQTGR5P",
