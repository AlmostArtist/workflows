        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: bank credit card\nAd format: comparison ad\nTarget viewer: a stay-at-home dad\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 30 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
