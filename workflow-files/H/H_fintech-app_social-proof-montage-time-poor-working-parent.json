        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: fintech app\nAd format: social proof montage\nTarget viewer: a time-poor working parent\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 30 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_EHCSTG62N17GN01SKRMERYN7R3",
