        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_VW1BP2VMGFGV6Q6SJM4S5SMCTJ",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
