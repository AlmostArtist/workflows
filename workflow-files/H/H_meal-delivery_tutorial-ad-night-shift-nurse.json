        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: meal delivery\nAd format: tutorial ad\nTarget viewer: a night-shift nurse\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 15 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_Y4D0SYG1QS3XK0WQ42MJS4NQ8X",
