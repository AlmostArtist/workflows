        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: laptop three-quarter\nDestination plate: gym rubber flooring (golden key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
