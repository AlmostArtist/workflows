        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 format-native hook planning. The first 1.5 seconds carry the whole retention load."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_J61Z3395GC8T2TDTS0BHE74Y21",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_V1FERNANTR389KGP5N2YTQMTVG",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
