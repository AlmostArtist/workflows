      },
      {
        "id": "nd_5ZTGK75C1AB3B1ZD2N14BK4QBW",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_48MQM1ZKHTYR53P2ART1QQPY9Y",
        "kind": "sticky-note",
