        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: desk lamp\nDestination plate: gallery white cube (studio key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_5D16QYWB2H90BTN3GY6QMK1JBR",
