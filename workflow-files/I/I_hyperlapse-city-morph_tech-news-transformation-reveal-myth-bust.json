        "name": "Stage 1"
      },
      {
        "id": "nd_8ZJRR5H52GTJXEJ5R4HJXF9997",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_YQZX111KQDPQ2EBA73PA82FR88",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
