        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: power tool\nDestination plate: minimal studio gradient (daylight key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_TEMXB7Z3SN2CW2AD02XBBD1V0N",
