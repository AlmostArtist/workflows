        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: armchair\nDestination plate: forest floor macro (night key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_SXNEFJ0VEG8P14P0J6D63XRMSY",
