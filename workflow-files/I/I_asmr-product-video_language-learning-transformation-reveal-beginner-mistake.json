          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_2KMXNZ0PZ4457K55KJNRFDJWNB",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
          "appendable_slots": {
            "parts": 2
          }
        },
        "name": "Brief joiner"
      },
      {
        "id": "nd_67ZJQBASC67Y3JHEX54PZ6D4XT",
        "kind": "text-input",
        "position": {
          "x": 0,
          "y": 980
        },
        "config": {
          "text": "TRANSFORMATION: [what changes]\nHOLD: [what must not change]"
        },
        "name": "Change contract"
      },
      {
        "id": "nd_TTJ58HZVKWDH68EF0Q9RRJ62QM",
        "kind": "text-gen",
        "position": {
          "x": 1050,
          "y": 700
        },
        "config": {
          "model": "gpt-5.5",
          "max_tokens": 900,
          "temperature": 0.75,
          "system_prompt": "You write the 'after' still prompt for an ASMR product video about language learning.\n\nThe attached before-image fixes framing, subject identity and camera position. Change ONLY what the change contract names; everything else \u2014 pose, crop, background geometry, focal length \u2014 stays identical so the reveal cuts cleanly.\n\nLight with flickering firelight as the only motivated source and grade to near-monochrome with a single accent hue allowed to stay saturated.\n\nReturn one prompt paragraph only.",
