        "name": "Stage 1"
      },
      {
        "id": "nd_68Y0NY0ABR7XSBNMTMG23G1F1X",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_VQ7ATSET9R68AQ7AFHK4GBXT36",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
