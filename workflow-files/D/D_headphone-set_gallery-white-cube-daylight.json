        "config": {},
        "name": "Cut out subject"
      },
      {
        "id": "nd_KQD8MY8MMT0RWRYS0GED1YXH48",
        "kind": "download",
        "position": {
          "x": 2800,
          "y": 420
        },
        "config": {
