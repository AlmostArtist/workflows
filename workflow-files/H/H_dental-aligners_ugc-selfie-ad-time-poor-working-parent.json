        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: dental aligners\nAd format: UGC selfie ad\nTarget viewer: a time-poor working parent\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 15 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_1CBPW9JF2QPQHAP2PK1PXN63MY",
