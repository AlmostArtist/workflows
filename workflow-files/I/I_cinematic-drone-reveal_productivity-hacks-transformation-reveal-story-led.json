        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: cinematic drone reveal\nTopic: productivity hacks\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 8s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_VDXCDKJ67S3GXEB4TQHF19X2K4",
