        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_9FRV022ZHANH2DGH86WX39Q81A",
        "kind": "text-gen",
        "position": {
