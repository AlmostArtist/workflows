    "name": "H \u2014 retail sale blast for mobile game, 20s",
    "nodes": [
      {
        "id": "nd_QSW29BPJDK40C2EDQZ3CPR4HQC",
        "kind": "prompt",
        "position": {
          "x": 0,
          "y": 400
        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: mobile game\nAd format: retail sale blast\nTarget viewer: a stay-at-home dad\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 20 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_E273H9V01J3TPE4DPKRVDWX4EY",
