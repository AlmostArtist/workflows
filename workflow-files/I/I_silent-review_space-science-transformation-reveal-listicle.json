        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_AH68FTYCQZBH9TFDB8M7CA5HC3",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
