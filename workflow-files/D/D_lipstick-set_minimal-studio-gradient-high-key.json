      },
      {
        "id": "nd_NH3A4MSKP0A5P7Q7AHZ0XA2RK5",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_R4C5K6HNS71ANDG9A5ZS16DBDP",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_JW9SQDG0T6YS4700YQX2WCEJRH",
        "kind": "bg-remove",
        "position": {
