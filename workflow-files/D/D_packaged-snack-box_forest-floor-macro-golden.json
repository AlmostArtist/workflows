        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: packaged snack box\nDestination plate: forest floor macro (golden key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_SNC4QTET3FA9GSWRT9K7527WTN",
