      },
      {
        "id": "nd_1BZ5FQ5BRNG05F5P1YJ4NHMKZV",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_M4F5CQBJMJY0TD7C955Q26D6KF",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_V8WTWPMCGW829TEE0DKE8QS55Q",
        "kind": "bg-remove",
        "position": {
