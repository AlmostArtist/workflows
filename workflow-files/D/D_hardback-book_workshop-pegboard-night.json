      },
      {
        "id": "nd_BH71XJ67F3X8VJVHK8X0XKH04N",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_VFS9WH6ADACS72J3CNAQRT9435",
        "kind": "sticky-note",
