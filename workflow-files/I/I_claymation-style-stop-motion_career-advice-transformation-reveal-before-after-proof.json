        "name": "Stage 1"
      },
      {
        "id": "nd_ZJF9JTRA27TWB5KPB8Z8AV971W",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_9MYA92G7EPKRPTNJA0GFHBS5QX",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
