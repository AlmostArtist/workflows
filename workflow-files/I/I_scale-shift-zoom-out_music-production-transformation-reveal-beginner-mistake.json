        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_B2PQHC46M2SDV7816WSW0EJYBV",
        "kind": "text-gen",
        "position": {
          "x": 700,
