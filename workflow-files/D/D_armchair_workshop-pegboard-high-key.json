        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: armchair\nDestination plate: workshop pegboard (high-key key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_TEHYX7DX1F2VCT8ER4DA47YKZ2",
