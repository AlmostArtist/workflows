          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_48RZNV92H73VQG6ARB05AVB7G6",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
