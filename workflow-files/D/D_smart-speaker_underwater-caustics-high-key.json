        "config": {},
        "name": "Cut out subject"
      },
      {
        "id": "nd_XJ5NPRR6SEYVFB3FFT5K23GNE9",
        "kind": "download",
        "position": {
          "x": 2800,
          "y": 420
        },
        "config": {
