        "name": "Stage 1"
      },
      {
        "id": "nd_02GAJMK0Z86VG9V7R06A6A0VMX",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_XQHMDMK7YAFDNHYVA9BARNMKZP",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
