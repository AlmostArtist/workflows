# Absolute path to the workflow library root (the folder containing A/, B/, ... viral/).
# Defaults to the parent directory of this app.
WORKFLOWS_LIBRARY_ROOT=/Users/you/Documents/Workflow Works/50k/Workflows Libarry

# Optional production mirror. Netlify uses this repository's `workflow-files/` directory
# automatically. Set this only to override it with your own CDN or object-storage base URL.
# WORKFLOWS_DOWNLOAD_BASE_URL=https://downloads.example.com/workflows

# Optional: point search at a Meilisearch instance instead of the built-in in-process index.
# Leave unset to use the built-in engine (recommended — no infrastructure required).
# MEILI_HOST=http://127.0.0.1:7700
# MEILI_KEY=

# --- ShopOS handoff ---------------------------------------------------------
# Canvas opened by the "Open in ShopOS" button after the workflow JSON is copied.
# NEXT_PUBLIC_SHOPOS_SPACELAB_URL=https://app.shopos.ai/spacelab/w/wf_01M2Z5M41BEZ6GPSBA3V7V4FS4/edit
# NEXT_PUBLIC_SHOPOS_SPACES_URL=https://app.shopos.ai/spaces?tab=your-spaces
#
# Optional. If ShopOS gains a URL-driven import, put the template here — {url} is
# replaced with the public URL of the .json, {id} with the workflow id. When set, the
# button navigates straight there and skips the copy-and-paste step.
# NEXT_PUBLIC_SHOPOS_IMPORT_URL=https://app.shopos.ai/spacelab/import?source={url}
