      },
      {
        "id": "nd_9DFKXQE23T6P7JS26BQ3V64EFG",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_DMVC01MP91248424Q5VPBRBW0H",
        "kind": "sticky-note",
        "position": {
