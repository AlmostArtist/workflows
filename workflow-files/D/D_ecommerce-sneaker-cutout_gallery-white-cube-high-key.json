          "image_size": "1K",
          "num_images": 1,
          "enable_eval": true,
          "eval_model": "gemini-2.5-pro",
          "eval_prompt": "Reject any render where the contact shadow is missing, the edge light contradicts the plate's key direction, or the product geometry or label differs from the cut-out.",
