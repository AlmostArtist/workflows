          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_D3R655FX6DGH3BW9DY9R8NJ2RS",
        "kind": "text-gen",
        "position": {
