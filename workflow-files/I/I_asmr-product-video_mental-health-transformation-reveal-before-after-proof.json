        "name": "Stage 1"
      },
      {
        "id": "nd_X04TEESTX1193M7ZE1PJQB5T19",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_44KSH29GK2FNDF4QM4R8H7QSCY",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
