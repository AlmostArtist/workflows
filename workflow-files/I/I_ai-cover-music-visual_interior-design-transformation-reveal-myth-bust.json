        },
        "name": "Before image"
      },
      {
        "id": "nd_AG8K9PGCFHB30X9EM10E6YZR9P",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
