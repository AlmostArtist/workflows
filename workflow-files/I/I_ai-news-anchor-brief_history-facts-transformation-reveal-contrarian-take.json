          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_HC7QDM7DGSRWHWCYG231MXZGM4",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
