      },
      {
        "id": "nd_4VHP8KZDHACT2FF5DW1D309V4V",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 subject is cut out, destination plates come in separately, and the relight director reconciles them."
        },
        "name": "Stage 1"
      },
      {
        "id": "nd_J949TR0FZRCMVKHPFG70SYR4YX",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 composite renders, then upscales before download."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_JB5BEB1YCEWDH94MP2S7R154YK",
        "kind": "bg-remove",
        "position": {
