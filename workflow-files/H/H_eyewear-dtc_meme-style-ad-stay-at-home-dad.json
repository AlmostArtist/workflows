        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: eyewear DTC\nAd format: meme-style ad\nTarget viewer: a stay-at-home dad\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 15 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_9DB8YJ1CP2HFSNBRJHRN8DK19K",
