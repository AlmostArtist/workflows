        },
        "config": {
          "text": "BRAND BRIEF \u2014 edit before running.\nBrand / vertical: telehealth\nAd format: street interview ad\nTarget viewer: a new graduate on a tight budget\nCore promise: [one sentence, no superlatives]\nProof point: [the one thing shown, not claimed]\nOffer / CTA: [exact wording]\nRuntime: 20 seconds. Do not invent claims beyond this brief."
        },
        "name": "Brand brief"
      },
      {
        "id": "nd_YWEAXK84NAMFFY8S2HVBXE0YND",
