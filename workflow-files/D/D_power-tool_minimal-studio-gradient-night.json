          "x": 0,
          "y": 820
        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: power tool\nDestination plate: minimal studio gradient (night key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_024YN08JHW8YB6W6J9NTQF5XED",
