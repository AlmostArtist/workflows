        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: desk lamp\nDestination plate: cloud-scape at altitude (high-key key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
