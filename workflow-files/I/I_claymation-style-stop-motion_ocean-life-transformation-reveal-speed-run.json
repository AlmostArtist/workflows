        "config": {
          "text": "SHORT-FORM BRIEF \u2014 edit before running.\nFormat: claymation-style stop motion\nTopic: ocean life\nHook (first 1.5s): [one line]\nPayoff: [one line]\nOn-screen text: [exact copy or leave blank]\nRuntime: 10s, 9:16, sound-on by default."
        },
        "name": "Short-form brief"
      },
      {
        "id": "nd_28VXJCXQ32DHTK01QFWY5GZXGZ",
        "kind": "sticky-note",
        "position": {
          "x": 0,
          "y": -60
        },
        "config": {
          "text": "STAGE 1 \u2014 format-native hook planning. The first 1.5 seconds carry the whole retention load."
