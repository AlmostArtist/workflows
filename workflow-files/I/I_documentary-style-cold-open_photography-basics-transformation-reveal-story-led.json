    "name": "I \u2014 documentary-style cold open on photography basics (transformation reveal)",
    "nodes": [
      {
        "id": "nd_Z1FGWFXDSAZQ56PGP31H6Z60VQ",
        "kind": "prompt",
        "position": {
          "x": 0,
          "y": 400
