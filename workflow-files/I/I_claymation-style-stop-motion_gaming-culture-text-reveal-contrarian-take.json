        "name": "Stage 1"
      },
      {
        "id": "nd_PD0RJDEGDK8DEYHFG5R9X3QRK4",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_4TVKH54HEB5P7H39JRX4SWSX6C",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
