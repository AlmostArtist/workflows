        "name": "Stage 1"
      },
      {
        "id": "nd_JX52HEYRXNPBTKR6M9FM7D8PB9",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_WAKS149NXF1JFQ5VXWNZRBXMST",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
