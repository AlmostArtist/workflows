          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_FSJN7YP7RZG7TSZN1D7Q0R2QGW",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
          "appendable_slots": {
