        "config": {
          "url": ""
        },
        "name": "Before image"
      },
      {
        "id": "nd_PRTN0KFSC6N17394CAWYQZ3Q87",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
