        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: sunglasses\nDestination plate: sunlit stucco wall (high-key key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_P3QRGW28NMDD9VQKD06TYGJXWZ",
