        "name": "Stage 1"
      },
      {
        "id": "nd_8PV2F35H5GB44PMKPES8QW1M17",
        "kind": "sticky-note",
        "position": {
          "x": 2100,
          "y": -60
        },
        "config": {
          "text": "STAGE 2 \u2014 render, finish and collect. Built for 9:16 sound-on playback."
        },
        "name": "Stage 2"
      },
      {
        "id": "nd_WJ1TDNS7P5T39J3KCCTECV5QE8",
        "kind": "text-gen",
        "position": {
          "x": 700,
          "y": 400
