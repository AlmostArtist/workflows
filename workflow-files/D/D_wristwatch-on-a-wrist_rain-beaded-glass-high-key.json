        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: wristwatch on a wrist\nDestination plate: rain-beaded glass (high-key key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_AD0W38SQ4MZBE9MWAM21MD5A63",
