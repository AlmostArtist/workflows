        },
        "config": {
          "text": "RETOUCH BRIEF \u2014 edit before running.\nSubject: headphone set\nDestination plate: gallery white cube (daylight key)\nKeep: product geometry, colourway, label text\nChange: background, lighting direction, contact shadow, grade\nOutput: relit composite, upscaled, ready for catalogue use."
        },
        "name": "Retouch brief"
      },
      {
        "id": "nd_KDJ40WXDXBQ3E5HXG214Y2NZPA",
