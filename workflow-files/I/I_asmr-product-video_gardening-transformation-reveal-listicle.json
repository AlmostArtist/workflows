        },
        "name": "Before image"
      },
      {
        "id": "nd_SNF8BA0X4QDZC8S1HT7GMS4JFG",
        "kind": "concat",
        "position": {
          "x": 350,
          "y": 520
        },
        "config": {
          "separator": "\n\n",
          "appendable_slots": {
